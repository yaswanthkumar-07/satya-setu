# Copy this file to ".env" (never commit .env) and adjust values.
# Only variables prefixed with VITE_ are exposed to the browser.
# Do NOT put secrets or private API keys here.

# Base URL of the Express API.
# In development "/api" is forwarded to http://localhost:5000 by vite.config.js.
# In production set the full URL of your deployed API (and enable CORS for your site on the server).
VITE_API_BASE_URL=/api

# "true"  = use local demonstration data (no backend needed)
# "false" = call the API through src/services
VITE_USE_DEMO_DATA=true

# Optional public contact email shown on the About page.
# Leave empty to hide the email link.
VITE_CONTACT_EMAIL=# Copy this file to ".env" (never commit .env) and adjust values.
